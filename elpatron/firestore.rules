rules_version = '2';
// Reglas para El Patrón (proyecto elpatron-b8c32).
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
// Cada jugador (cuenta usuario@godsplan.site) solo puede ver y cambiar SUS partidas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow get, create, update: if request.auth != null && request.auth.uid == uid;
      allow list, delete: if false;

      match /slots/{slot} {
        allow get, delete: if request.auth != null && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && slot.matches('^(clasica|v1|v2|v3)_[1-3]$')
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
      }
    }
  }
}
