rules_version = '2';
// Reglas para El Patrón (proyecto elpatron-b8c32).
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // perfil = huella de "alias|clave" (32 caracteres hex); nadie puede listar perfiles
    match /profiles/{pid} {
      allow get, create, update: if request.auth != null && pid.size() == 32;
      allow list, delete: if false;

      match /slots/{slot} {
        allow get, delete: if request.auth != null;
        allow list: if false;
        allow create, update: if request.auth != null
          && slot.matches('^(clasica|v1|v2|v3)_[1-3]$')
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
      }
    }
  }
}
